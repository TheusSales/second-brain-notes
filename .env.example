# ============================================================
# Provedor atual: Groq (gratuito)
# Obtenha sua chave em: https://console.groq.com
# ============================================================
GROQ_API_KEY=sua-chave-aqui

# Caminho para a pasta Inbox do vault do Obsidian (opcional)
# Padrão: ~/Documents/Obsidian/Vault/Inbox
# OBSIDIAN_VAULT_PATH=/caminho/customizado/para/vault

# Modelo Groq a ser utilizado (opcional)
# Padrão: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Roadmap — Multi-provider (futuro)
# Quando o AI wrapper for implementado, as variáveis abaixo
# serão suportadas para seleção de provedor por usuário.
# ============================================================
# AI_PROVIDER=groq          # groq | gemini | openai | anthropic
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
