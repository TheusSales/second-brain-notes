# ============================================================
# Provedor de IA
# Opções: groq | openai | anthropic | gemini
# ============================================================
AI_PROVIDER=groq

# ============================================================
# Chaves de API (configure apenas a do provedor escolhido)
# ============================================================

# Groq (gratuito) — https://console.groq.com
GROQ_API_KEY=sua-chave-aqui
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic — https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=AI...
# GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# Obsidian
# ============================================================
# Caminho para a pasta Inbox do vault do Obsidian (opcional)
# Padrão: ~/Documents/Obsidian/Vault/Inbox
# OBSIDIAN_VAULT_PATH=/caminho/customizado/para/vault

# ============================================================
# Telegram
# ============================================================
# Crie um bot via @BotFather no Telegram para obter o token
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ============================================================
# Docker / Deploy
# ============================================================
# Caminho na máquina host para o vault (usado pelo docker-compose)
# VAULT_HOST_PATH=/home/user/vault
